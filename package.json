{
  "name": "pgstudio-lite",
  "version": "0.3.0",
  "private": true,
  "description": "PostgreSQL SQL + Table Editor (Next.js + TypeScript) inspired by Supabase Studio, with SQLite-backed query history",
  "scripts": {
    "dev": "next dev -p 4180",
    "build": "next build",
    "start": "next start -p 4180",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "next": "~16.0.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.0.4",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
