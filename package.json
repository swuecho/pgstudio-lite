{
  "name": "pgstudio-lite",
  "version": "0.3.0",
  "private": true,
  "description": "PostgreSQL SQL + Table Editor (Next.js + TypeScript) inspired by Supabase Studio, with SQLite-backed query history",
  "scripts": {
    "dev": "next dev -p 4180",
    "build": "next build",
    "start": "next start -p 4180",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@pgsql/parser": "^1.2.1",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-virtual": "^3.13.23",
    "better-sqlite3": "^12.6.2",
    "drizzle-orm": "^0.45.1",
    "next": "~16.0.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.24",
    "drizzle-kit": "^0.31.9",
    "eslint": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.0.18"
  }
}
