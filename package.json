{
  "name": "pgstudio-lite",
  "version": "0.5.1",
  "private": true,
  "description": "PostgreSQL SQL + Table Editor (Vite + React + TanStack Router) inspired by Supabase Studio, with SQLite-backed query history",
  "license": "MIT",
  "author": "Hao Wu <echowuhao@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swuecho/pgstudio-lite.git"
  },
  "homepage": "https://github.com/swuecho/pgstudio-lite#readme",
  "bugs": {
    "url": "https://github.com/swuecho/pgstudio-lite/issues"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-web-server.mjs",
    "start": "node dist-server/main.mjs",
    "desktop:icon": "electron scripts/icon/main.mjs",
    "desktop:native": "node scripts/build-sqlite-native.mjs",
    "desktop:renderer": "node scripts/build-desktop-renderer.mjs",
    "desktop:main": "node scripts/build-electron.mjs",
    "desktop:build": "npm run desktop:icon && npm run desktop:native && npm run desktop:renderer && npm run desktop:main",
    "desktop:preview": "npm run desktop:build && electron .",
    "desktop:dist": "npm run desktop:build && electron-builder",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:snapshots": "node scripts/rebuild-migration-snapshots.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && npm run db:up",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/pg.integration.test.ts",
    "test:integration:local": "PGSTUDIO_PG_INTEGRATION=1 PG_CONNECTION_STRING=postgres://postgres:postgres@127.0.0.1:${PGSTUDIO_PG_PORT:-5432}/postgres PG_CONNECTION_NAME=default vitest run tests/pg.integration.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@monaco-editor/react": "^4.6.0",
    "@pgsql/parser": "^1.5.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-virtual": "^3.14.10",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.1",
    "echarts": "^6.1.0",
    "hono": "^4.13.16",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.6.2",
    "drizzle-kit": "^0.31.11",
    "electron": "42.11.18",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "prettier --write",
      "eslint"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "main": "dist-electron/main.js"
}
