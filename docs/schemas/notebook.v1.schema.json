{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pgstudio-lite.local/schemas/notebook.v1.schema.json",
  "title": "PG Studio Notebook Spec v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "title",
    "cells"
  ],
  "properties": {
    "spec_version": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "connection_name": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object"
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/cell"
      }
    }
  },
  "$defs": {
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "sql",
            "markdown",
            "input"
          ]
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "collapsed": {
          "type": "boolean"
        },
        "content": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "input"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "metadata"
            ],
            "properties": {
              "metadata": {
                "$ref": "#/$defs/inputMetadata"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "sql"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "inputMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "inputType",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "inputType": {
          "type": "string",
          "enum": [
            "text",
            "number",
            "date",
            "datetime-local",
            "checkbox",
            "select",
            "range",
            "multiselect"
          ]
        },
        "value": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "required": {
          "type": "boolean"
        },
        "placeholder": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inputOption"
          }
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "step": {
          "type": "number"
        },
        "autoRun": {
          "type": "boolean"
        }
      }
    },
    "inputOption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "value"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
