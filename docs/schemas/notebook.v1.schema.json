{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pgstudio-lite.local/schemas/notebook.v1.schema.json",
  "title": "PG Studio Notebook Spec v1",
  "description": "Notebook document accepted by POST /api/notebooks/import and returned by GET /api/notebooks/:id/export. The server's Zod schemas in lib/notebook-spec.ts and lib/notebook-widgets.ts are the source of truth; tests/notebook-spec-docs.test.ts keeps this file in step with them. Unlike the server, which ignores unknown keys, this schema rejects them so that typos surface while authoring.",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "title", "cells"],
  "properties": {
    "spec_version": { "type": "string", "const": "1.0" },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "connection_name": {
      "type": "string",
      "minLength": 1,
      "description": "Saved connection to run the notebook against. Omit to use the default connection."
    },
    "metadata": { "type": "object" },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/cell" }
    }
  },
  "definitions": {
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "content"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable id, unique within the notebook."
        },
        "type": { "type": "string", "enum": ["sql", "markdown", "widget"] },
        "position": { "type": "integer", "minimum": 0 },
        "collapsed": { "type": "boolean" },
        "content": { "type": "string" },
        "metadata": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "widget" } }, "required": ["type"] },
          "then": {
            "required": ["metadata"],
            "properties": { "metadata": { "$ref": "#/definitions/widgetMetadata" } }
          }
        },
        {
          "if": { "properties": { "type": { "const": "sql" } }, "required": ["type"] },
          "then": { "properties": { "content": { "type": "string", "pattern": "\\S" } } }
        }
      ]
    },
    "paramKey": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "dateRangeValue": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string" },
        "end": { "type": "string" }
      }
    },
    "widgetMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["widgetType"],
      "properties": {
        "widgetType": {
          "type": "string",
          "enum": [
            "text",
            "number",
            "date",
            "datetime-local",
            "checkbox",
            "select",
            "range",
            "multiselect",
            "radio-group",
            "date-range",
            "actions",
            "callout"
          ]
        },
        "key": {
          "$ref": "#/definitions/paramKey",
          "description": "Parameter name; SQL cells reference it as {{key}}."
        },
        "label": { "type": "string", "minLength": 1 },
        "helpText": { "type": "string", "minLength": 1 },
        "autoRun": {
          "type": "boolean",
          "description": "Re-run the SQL cells that use this parameter when its value changes."
        },
        "hidden": { "type": "boolean" },
        "disabled": { "type": "boolean" },
        "required": { "type": "boolean" },
        "placeholder": { "type": "string" },
        "value": {},
        "defaultValue": {},
        "options": { "type": "array", "items": { "$ref": "#/definitions/option" } },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number" },
        "config": { "type": "object" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "widgetType": {
                "enum": [
                  "text",
                  "number",
                  "date",
                  "datetime-local",
                  "checkbox",
                  "select",
                  "range",
                  "multiselect",
                  "radio-group"
                ]
              }
            }
          },
          "then": { "required": ["key", "label"] }
        },
        {
          "if": { "properties": { "widgetType": { "enum": ["text", "date", "datetime-local", "select"] } } },
          "then": { "properties": { "value": { "type": "string" } } }
        },
        {
          "if": { "properties": { "widgetType": { "const": "checkbox" } } },
          "then": { "properties": { "value": { "type": "boolean" } } }
        },
        {
          "if": { "properties": { "widgetType": { "enum": ["number", "range"] } } },
          "then": { "properties": { "value": { "type": ["number", "null"] } } }
        },
        {
          "if": { "properties": { "widgetType": { "const": "multiselect" } } },
          "then": { "properties": { "value": { "type": "array", "items": { "type": "string" } } } }
        },
        {
          "$comment": "select and multiselect need options, unless config.optionSource is 'sql', which needs config.optionsQuery instead.",
          "if": {
            "properties": { "widgetType": { "enum": ["select", "multiselect"] } }
          },
          "then": {
            "if": {
              "properties": {
                "config": {
                  "properties": { "optionSource": { "const": "sql" } },
                  "required": ["optionSource"]
                }
              },
              "required": ["config"]
            },
            "then": {
              "properties": {
                "config": {
                  "required": ["optionsQuery"],
                  "properties": { "optionsQuery": { "type": "string", "pattern": "\\S" } }
                }
              }
            },
            "else": { "required": ["options"], "properties": { "options": { "minItems": 1 } } }
          }
        },
        {
          "if": { "properties": { "widgetType": { "const": "radio-group" } } },
          "then": {
            "required": ["options"],
            "properties": {
              "options": { "minItems": 1 },
              "value": { "type": "string" },
              "defaultValue": { "type": "string" }
            }
          }
        },
        {
          "$comment": "Binds two parameters, config.startKey and config.endKey; the widget's own key is unused.",
          "if": { "properties": { "widgetType": { "const": "date-range" } } },
          "then": {
            "required": ["config"],
            "properties": {
              "config": {
                "type": "object",
                "required": ["startKey", "endKey"],
                "properties": {
                  "startKey": { "$ref": "#/definitions/paramKey" },
                  "endKey": { "$ref": "#/definitions/paramKey" }
                }
              },
              "value": { "$ref": "#/definitions/dateRangeValue" },
              "defaultValue": { "$ref": "#/definitions/dateRangeValue" }
            }
          }
        },
        {
          "$comment": "A button that runs every SQL cell, or the cells listed in config.targetCellIds.",
          "if": { "properties": { "widgetType": { "const": "actions" } } },
          "then": {
            "not": { "required": ["key"] },
            "required": ["config"],
            "properties": {
              "config": {
                "type": "object",
                "required": ["action"],
                "properties": {
                  "action": { "enum": ["run-all", "run-targets"] },
                  "targetCellIds": { "type": "array", "items": { "type": "string" } }
                },
                "if": { "properties": { "action": { "const": "run-targets" } } },
                "then": {
                  "required": ["targetCellIds"],
                  "properties": { "targetCellIds": { "minItems": 1 } }
                }
              }
            }
          }
        },
        {
          "$comment": "A static note; needs a non-empty config.title or config.body.",
          "if": { "properties": { "widgetType": { "const": "callout" } } },
          "then": {
            "not": { "required": ["key"] },
            "required": ["config"],
            "properties": {
              "config": {
                "type": "object",
                "anyOf": [
                  {
                    "required": ["title"],
                    "properties": { "title": { "type": "string", "pattern": "\\S" } }
                  },
                  { "required": ["body"], "properties": { "body": { "type": "string", "pattern": "\\S" } } }
                ]
              }
            }
          }
        }
      ]
    }
  }
}
