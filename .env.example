PG_CONNECTION_STRING=postgres://postgres:postgres@localhost:5432/postgres
PG_CONNECTION_NAME=local
PG_CONNECTION_READ_ONLY=false

# Optional: seed multiple connections on first boot instead of the single
# PG_CONNECTION_* values above.
# PG_CONNECTIONS_JSON=[{"name":"local","connectionString":"postgres://postgres:postgres@localhost:5432/postgres","isDefault":true,"readOnly":false}]

# Optional: override where the local SQLite metadata DB is stored.
# Default: ./data/history.db
# PGSTUDIO_META_DB_PATH=./data/history.db

# Optional: disable runtime migrations if your deployment runs them separately.
# SKIP_RUNTIME_MIGRATE=0
